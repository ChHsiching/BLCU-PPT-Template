    "subhead_max_chars": "小标题块字数上限（单行 @subhead_size_pt；无小标题区的页型为 0）",
    "list_items_max / list_item_max_chars": "列表条数 / 单条字数上限（条目字数计入 text_total）",
    "formulas_max": "显示公式个数上限",
    "images_min / images_max": "图片数量下/上限",

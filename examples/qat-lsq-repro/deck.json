    {
      "archetype": "agenda",
      "blocks": [
        { "type": "title", "text": "汇报大纲" },
        {
          "type": "list",
          "items": [
            "一 背景：均匀量化与后训练塌陷",
            "二 方法：直通估计与可学习步长",
            "三 复现设置：数据、网络与超参",
            "四 实验：训练曲线、比特扫描与消融",
            "五 结论：复现发现与后续计划"
          ]
